{
    "name": "llmscatalog/prestashop-module",
    "description": "Development tooling for the 'LLMs.txt for PrestaShop' module. The shipped module stays dependency-free; this file only wires lint/test tooling.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "find llmscatalog tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit -c phpunit.xml.dist",
        "test:unit": "phpunit -c phpunit.xml.dist --testsuite unit",
        "test:integration": "phpunit -c phpunit.xml.dist --testsuite integration"
    }
}
